# ============================================
# Campus Knowledge Hub - Environment Variables
# Copy to .env and fill in the values.
# ============================================

# --- Required: JWT Signing Key ---
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# --- Spring Profile (dev / prod) ---
SPRING_PROFILES_ACTIVE=dev

# --- MySQL ---
MYSQL_URL=jdbc:mysql://localhost:3306/campus_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5572
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- PostgreSQL + pgvector (optional, set VECTOR_SEARCH_ENABLED=false to disable) ---
VECTOR_SEARCH_ENABLED=true
VECTOR_DB_URL=jdbc:postgresql://localhost:5433/campus_ai_vector
VECTOR_DB_USERNAME=campus_ai
VECTOR_DB_PASSWORD=campus_ai

# --- LLM (DeepSeek) ---
LLM_MODE=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true

# --- Server Port ---
SERVER_PORT=8081
